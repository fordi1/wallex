# Judging deliverables are kept: decision log, trades and backtest reports
logs/*
!logs/decisions.jsonl
!logs/trades.csv
logs/engine-*.log
logs/engine-process.json

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
