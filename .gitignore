# Secrets and local environment
.env
.env.*
!.env.example
.streamlit/secrets.toml
.claude/
.venv/

# Python and tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.hypothesis/

# Local databases and raw market data (regenerable)
*.db
*.sqlite3
data/*
