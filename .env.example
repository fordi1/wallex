# Never paste credentials into config.yaml or source control.
WALLEX_API_KEY=
LIARA_AI_API_KEY=
LIARA_AI_BASE_URL=
BOX_API_KEY=
BOX_API_BASE_URL=https://ai.boxapi.ir/ai/v1
OPENAI_API_KEY=
DATABASE_URL=sqlite+aiosqlite:///./data/wallex.db
DASHBOARD_DATABASE_URL=sqlite:///./data/wallex.db
DASHBOARD_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# These gates must be explicitly true before live mode can start.
WALLEX_EXPOSED_KEY_REVOKED=false
WALLEX_KEY_TRADE_ONLY=false
WALLEX_KEY_IP_RESTRICTED=false
SHADOW_GATE_APPROVED=false
LIVE_TRADING_ENABLED=false
LIVE_RESTART_ACKNOWLEDGED=false


# Lets the dashboard start/stop the engine; keep false on shared deployments.
DASHBOARD_CONTROL_ENABLED=false
